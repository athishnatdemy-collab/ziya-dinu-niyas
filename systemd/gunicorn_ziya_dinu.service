[Unit]
Description=Gunicorn daemon for ziya-dinu.vandmark.com (Nikah Invitation)
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/ziya-dinu.vandmark.com
Environment="PATH=/var/www/ziya-dinu.vandmark.com/venv/bin"
ExecStart=/var/www/ziya-dinu.vandmark.com/venv/bin/gunicorn \
          --workers 3 \
          --bind unix:/var/www/ziya-dinu.vandmark.com/gunicorn.sock \
          --umask 007 \
          core.wsgi:application

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
